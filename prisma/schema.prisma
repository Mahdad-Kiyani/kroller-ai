// W&I AI microservice — persistence model.
// DDD note: INFRASTRUCTURE concern. Aggregates map to these tables via mappers;
// the domain layer never imports Prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum WarrantyCategory {
  FUNDAMENTAL
  BUSINESS
  TAX
  TAX_INDEMNITY
}

enum CoveragePosition {
  COVERED
  PARTIAL
  EXCLUDED
}

enum DocumentStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
}

// Scrape presence, tri-state. NO = no qualifier; PARTIAL = a qualifier is present but only
// narrows part of the statement; YES = the warranty is given subject to the qualifier.
// The deterministic detector emits NO/YES; PARTIAL is reachable only via human override.
enum ScrapeStatus {
  NO
  PARTIAL
  YES
}

// A grouping/engagement the AI operates within. Owned by the panel; referenced here
// by externalRef. Kept deliberately lightweight (this service is AI-only).
model Deal {
  id           String      @id @default(uuid())
  externalRef  String      @unique
  name         String
  governingLaw String?
  warranties   Warranty[]
  exclusions   Exclusion[]
  documents    Document[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Document {
  id         String         @id @default(uuid())
  dealId     String
  deal       Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  storageKey String // MinIO object key
  filename   String
  mimeType   String
  status     DocumentStatus @default(UPLOADED)
  error      String?
  warranties Warranty[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([dealId])
}

model Warranty {
  id           String    @id @default(uuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Nullable: warranties created before this link was added have no traceable source document.
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  spaReference String // verbatim SPA numbering — never regenerated
  title        String
  fullText     String

  // --- AI categorisation (immutable suggestion) ---
  aiCategory   WarrantyCategory?
  aiConfidence Float?
  pageRef      Int?
  // effective category after optional human override
  category     WarrantyCategory?
  overriddenBy String?
  overriddenAt DateTime?

  // --- AI coverage-position suggestion (learning loop) ---
  aiPosition      CoveragePosition?
  aiComment       String?
  aiPositionScore Float? // similarity-derived confidence 0..1
  // human decision (the training signal)
  decidedPosition CoveragePosition?
  decidedComment  String?
  decidedBy       String?
  decidedAt       DateTime?

  // --- Knowledge / materiality "scrapes" ---
  // AI-detected qualifiers (immutable suggestion), then effective values after optional
  // human override, then override provenance. Mirrors the category/position override triad.
  aiKnowledgeScrape       ScrapeStatus @default(NO)
  aiMaterialityScrape     ScrapeStatus @default(NO)
  // exact detected qualifier phrase(s) — legally meaningful evidence for the audit trail
  aiKnowledgeScrapeText   String?
  aiMaterialityScrapeText String?
  knowledgeScrape         ScrapeStatus @default(NO)
  materialityScrape       ScrapeStatus @default(NO)
  scrapesOverriddenBy     String?
  scrapesOverriddenAt     DateTime?

  // --- stable ordering (deterministic in-deal sort) ---
  sortKey String?
  ordinal Int?

  // --- retrieval ---
  embedding    Unsupported("vector(1536)")?
  searchVector Unsupported("tsvector")?

  impacts   ExclusionImpact[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([dealId, spaReference])
  @@index([dealId])
  @@index([documentId])
  @@index([dealId, sortKey, ordinal])
  @@index([dealId, knowledgeScrape])
  @@index([dealId, materialityScrape])
}

model Exclusion {
  id         String            @id @default(uuid())
  dealId     String
  deal       Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  label      String
  text       String
  isStandard Boolean           @default(true)
  impacts    ExclusionImpact[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([dealId])
}

// Coverage-effect of an exclusion on a warranty.
// FULL removes coverage; PARTIAL limits it; CARVE_OUT removes a specific case.
enum ImpactType {
  FULL
  PARTIAL
  CARVE_OUT
}

// AI-produced mapping: which warranties an exclusion impacts, with rationale + confidence.
model ExclusionImpact {
  id          String     @id @default(uuid())
  exclusionId String
  exclusion   Exclusion  @relation(fields: [exclusionId], references: [id], onDelete: Cascade)
  warrantyId  String
  warranty    Warranty   @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  type        ImpactType @default(PARTIAL)
  rationale   String
  confidence  Float
  createdAt   DateTime   @default(now())

  @@unique([exclusionId, warrantyId])
  @@index([warrantyId])
}

// Immutable record capturing AI suggestion (before) vs human decision (after).
// The engine of the learning loop. Retention: 7 years.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
}
